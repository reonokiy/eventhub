# Local development only. Do not deploy this file or these fixed credentials.
# Production must set NODE_ENV=production and replace BOOTSTRAP_API_KEY,
# ADMIN_API_KEY, and BOOTSTRAP_WEBHOOK_SECRET through a Secret Manager or
# deployment-specific environment. The service refuses its built-in development
# values in production; the two API keys must each be at least 32 characters.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
EVENTHUB_PORT=3000
EVENTHUB_BIND_ADDRESS=127.0.0.1
LOG_LEVEL=info

POSTGRES_DB=eventhub
POSTGRES_USER=eventhub
POSTGRES_PASSWORD=eventhub
POSTGRES_PORT=5433
POSTGRES_BIND_ADDRESS=127.0.0.1
COMPOSE_DATABASE_URL=postgres://eventhub:eventhub@postgres:5432/eventhub
DATABASE_URL=postgres://eventhub:eventhub@localhost:5433/eventhub
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=30000
MIGRATE_ON_START=true

BOOTSTRAP_TENANT_ID=00000000-0000-4000-8000-000000000001
BOOTSTRAP_TENANT_NAME=Default tenant
BOOTSTRAP_API_KEY=dev-api-key-change-me
# Dedicated operator credential for /v1/admin. Do not use an application API key
# (generated application keys begin with ehk_ and are rejected here).
ADMIN_API_KEY=dev-admin-api-key-change-me
BOOTSTRAP_WEBHOOK_CONNECTION_ID=00000000-0000-4000-8000-000000000002
BOOTSTRAP_WEBHOOK_SECRET=dev-webhook-secret-change-me

EVENT_RETENTION_DAYS=30
MAX_EVENT_BYTES=1048576
SSE_BATCH_SIZE=200
SSE_POLL_INTERVAL_MS=5000
SSE_HEARTBEAT_INTERVAL_MS=15000
SSE_WRITE_TIMEOUT_MS=30000
WEBHOOK_MAX_CLOCK_SKEW_SECONDS=300
