{
  "name": "eventhub",
  "version": "0.1.0",
  "private": true,
  "description": "PostgreSQL-backed multi-source event stream with replayable SSE subscriptions",
  "type": "module",
  "exports": {
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    },
    "./sdk/node": {
      "types": "./dist/sdk/node.d.ts",
      "import": "./dist/sdk/node.js"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "tsx --test test/**/*.test.ts",
    "test:coverage": "c8 tsx --test test/**/*.test.ts",
    "test:integration": "tsx --test test/integration/**/*.test.ts",
    "migrate": "tsx src/cli/migrate.ts",
    "provision:client": "tsx src/cli/provision-client.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "fastify": "5.10.0",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "c8": "12.0.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
